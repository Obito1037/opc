{
  "name": "yingshen-tryon-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "映身 — 本地照片识别、动态试穿与数字人搭配实验室",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "prebuild": "node scripts/prepare-notices.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "setup:models": "node scripts/setup-models.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "setup:tryon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vton-v4/install.ps1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.0.3"
  }
}
